NODE_ENV=development
LOG_LEVEL=info

# ── Session store ────────────────────────────────────────────────────────────
# 'memory' = in-process Map (free, dev/test only)
# 'redis'  = Redis-backed (multi-process safe, production)
SESSION_STORE=memory
SESSION_TTL_SECONDS=1800

# Required when SESSION_STORE=redis
REDIS_URL=redis://localhost:6379
REDIS_NAMESPACE=gridee

# ── Backend API ──────────────────────────────────────────────────────────────
BACKEND_API_URL=http://localhost:3000
BACKEND_API_TIMEOUT_MS=10000

# ── Messaging provider ───────────────────────────────────────────────────────
# 'twilio' for testing, 'whatsapp_cloud' or 'africas_talking' in production
MESSAGING_PROVIDER=twilio

# ── Twilio (sandbox or production) ───────────────────────────────────────────
# Find SID + auth token at https://console.twilio.com
# WHATSAPP_FROM default below is the public sandbox number — works for testing
# without requesting WhatsApp Business approval. Use your own approved sender
# in production.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# REQUIRED for inbound webhook signature verification.
# This MUST be the exact public URL Twilio is configured to call. Local dev
# example using ngrok:  https://abc123.ngrok-free.app/webhook
# Without this, all inbound webhooks fail signature verification → 401.
TWILIO_PUBLIC_WEBHOOK_URL=

# ── WhatsApp Cloud (Meta) — only when MESSAGING_PROVIDER=whatsapp_cloud ──────
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
WHATSAPP_CLOUD_APP_SECRET=
WHATSAPP_CLOUD_VERIFY_TOKEN=

# ── Africa's Talking — only when MESSAGING_PROVIDER=africas_talking ─────────
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=
AT_WEBHOOK_SECRET=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# Webhook path the messaging provider POSTs to. Default '/webhook'.
# Use a per-provider path if you want to run multiple providers behind one
# host, e.g. '/webhook/twilio' for Twilio, '/webhook/meta' for WhatsApp Cloud.
# This must MATCH the URL configured in the provider's dashboard.
WEBHOOK_PATH=/webhook
